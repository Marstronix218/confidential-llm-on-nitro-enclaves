# Local mock of the enclave for `docker compose up` (no Nitro hardware needed).
# Runs the exact same vsock_server.py, but over TCP instead of vsock.
# The real enclave image is built from enclave/Dockerfile with nitro-cli.
# Build context: the repo root (docker-compose.yml sets it).
#
#   docker compose build                                   # Qwen2.5-0.5B-Instruct (default)
#   ENCLAVE_MODEL=distilgpt2 docker compose build enclave  # switch back to the original GPT-2
# python:3.11.17-slim
FROM python@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

ARG MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

WORKDIR /app

# Same hash-locked dependencies as the real enclave image (enclave/requirements.in -> requirements.txt)
COPY enclave/requirements.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# Download the model at build time so the container starts offline
COPY enclave/download_model.py ./
RUN python download_model.py "${MODEL_ID}" /app/model

COPY enclave/vsock_server.py enclave/nsm.py common/utils.py ./

ENV ENCLAVE_TRANSPORT=tcp \
    MODEL_DIR=/app/model \
    PYTHONUNBUFFERED=1

EXPOSE 5000
CMD ["python", "vsock_server.py"]
