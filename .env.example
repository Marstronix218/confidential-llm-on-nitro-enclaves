# Control plane (control-plane/api/admin.py, chat.py)
# Copy to .env and fill in values for your own AWS account. Never commit .env.

AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=123456789012

# IAM role / instance profile attached to the data-plane EC2 instance
ENCLAVE_IAM_ROLE=ConfidentialLLMEnclave

# Enclave measurements printed by `nitro-cli build-enclave` (used in the KMS key policy)
ENCLAVE_PCR0=
ENCLAVE_PCR1=
ENCLAVE_PCR2=
# true = run the enclave with --debug-mode (PCRs become all zeros; attestation is NOT meaningful)
ENCLAVE_DEBUG_MODE=true

# Data-plane EC2 instance created by admin.py
DATA_PLANE_AMI_ID=ami-xxxxxxxxxxxxxxxxx
DATA_PLANE_INSTANCE_TYPE=m5.2xlarge
DATA_PLANE_KEY_NAME=
DATA_PLANE_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxxxxxxx,sg-yyyyyyyyyyyyyyyyy
DATA_PLANE_REPO_DIR=/home/ec2-user/confidential-llm-on-nitro-enclaves
DATA_PLANE_VENV=/home/ec2-user/venv
# ENCLAVE_EIF_PATH=/home/ec2-user/confidential-llm-on-nitro-enclaves/enclave/llm.eif

# Control-plane instance(s), optional
CONTROL_PLANE_INSTANCE_IDS=

# chat.py -> admin.py (same host by default), used to look up the data-plane IP
CONTROL_PLANE_HOST=http://localhost:5000
# Set this to skip the admin.py lookup (docker compose sets it to http://data-plane:5000)
# DATA_PLANE_URL=http://10.0.0.5:5000
# KEY_DIRECTORY=/path/to/keys
# Seconds to wait for the enclave to generate text
TEE_TIMEOUT=120

# Enclave (enclave/vsock_server.py)
# MODEL_DIR=/app/model
# MAX_NEW_TOKENS=150
# SYSTEM_PROMPT=You are a helpful assistant running inside a trusted execution environment. Answer concisely.
# Local mock only: model baked into the image at build time (any HF causal LM id)
# ENCLAVE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Data plane (data-plane/vsock_api_server.py): "vsock" on Nitro, "tcp" for the local mock
# ENCLAVE_TRANSPORT=vsock
# ENCLAVE_HOST=localhost

# URL shown to the user after /api/demo/start
DEMO_URL=http://localhost:8080
